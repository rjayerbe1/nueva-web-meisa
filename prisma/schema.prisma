// ============================================
// Talento Humano — vacantes + banco de hojas de vida (ATS interno)
// Fase interna: TH carga CVs a mano; la página pública queda apagada
// tras ConfiguracionTalento.paginaPublicaActiva (switch en DB, sin deploy).
// Los CVs viven en el bucket PRIVADO gs://meisa-hojas-de-vida (nunca en
// meisa-imagenes, que es público a nivel de bucket) y se sirven solo vía
// proxy autenticado /api/admin/talento/cv/[candidatoId].
// ============================================

enum EstadoVacante {
  BORRADOR
  ABIERTA
  PAUSADA
  CERRADA
}

enum EtapaPostulacion {
  RECIBIDA
  PRESELECCION
  ENTREVISTA
  OFERTA
  CONTRATADA
  DESCARTADA
}

model Vacante {
  id          String        @id @default(cuid())
  slug        String        @unique
  titulo      String
  area        String? // Producción / Ingeniería / Montaje / Administrativo...
  ciudad      String?
  modalidad   String? // presencial | hibrido | remoto
  descripcion String
  // Requisitos por méritos (Ley 931/2004: nunca edad/sexo/estado civil)
  requisitos        String[] @default([])
  responsabilidades String[] @default([])
  beneficios        String[] @default([])
  tipoContrato      String? // indefinido | fijo | obra-labor | aprendizaje
  jornada           String? // FULL_TIME | PART_TIME | CONTRACTOR... (mapea a JobPosting employmentType)
  salarioMin        Int? // COP/mes — obligatorio al registrar en SPE
  salarioMax        Int?
  salarioVisible    Boolean  @default(false) // mostrarlo o no cuando la página sea pública

  estado           EstadoVacante @default(BORRADOR)
  fechaPublicacion DateTime?
  fechaCierre      DateTime? // validThrough de JobPosting

  // Programa de Referidos: el objetivo estratégico es específicamente el
  // personal operativo de planta (soldadores, armadores, ayudantes...), que
  // es quien conoce a otros con el mismo oficio — no aplica a cualquier
  // vacante. Cualquier colaborador puede compartir su código, pero el
  // incentivo solo se activa cuando el referido aplica a una vacante marcada
  // como elegible.
  elegibleReferidos Boolean @default(false)

  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postulaciones Postulacion[]
  publicaciones PublicacionVacante[]
  comparativos  ComparativoVacante[]

  @@index([estado, orden])
  @@map("vacantes")
}

// Comparativo IA de candidatos contra un perfil de cargo (terna/matriz de
// evaluación). Se guarda como historial; es SUGERENCIA con decisión humana
// (Circular SIC 002/2024).
model ComparativoVacante {
  id        String  @id @default(cuid())
  vacanteId String
  vacante   Vacante @relation(fields: [vacanteId], references: [id], onDelete: Cascade)

  resultados Json // { evaluaciones: [{candidatoId, nombre, score, fortalezas, brechas, recomendacion}], conclusion }
  creadoPor  String?
  createdAt  DateTime @default(now())

  @@index([vacanteId, createdAt])
  @@map("comparativos_vacante")
}

model Candidato {
  id       String  @id @default(cuid())
  nombre   String
  email    String?
  telefono String?
  ciudad   String?

  cvPathGcs     String? // path en gs://meisa-hojas-de-vida (privado)
  cvFileName    String?
  cvContentType String?
  cvSize        Int?

  // Trazabilidad habeas data (Ley 1581/2012): por dónde llegó el CV y
  // cuándo quedó registrado; base para la purga por retención.
  origen        String? // computrabajo | magneto | elempleo | linkedin | spe | referido | email | whatsapp | fisico | web
  origenDetalle String?
  areaInteres   String? // organización del pool: SST | Producción | Ingeniería | Administrativa...

  // Programa de referidos: el CANDIDATO ingresa el código al aplicar (nunca el
  // empleado entregando datos de un tercero) — así el consentimiento de datos
  // personales lo da la propia persona referida, no un colaborador por ella.
  codigoReferidoId    String?
  codigoReferido      CodigoReferido? @relation(fields: [codigoReferidoId], references: [id], onDelete: SetNull)
  codigoReferidoTexto String? // lo que escribió el candidato, para reconciliar si no hizo match exacto
  consentimientoBanco Boolean   @default(false) // autorizó conservar el CV para vacantes futuras
  consentimientoFecha DateTime?
  consentimientoVia   String? // formulario-web | bolsa-de-empleo | entregado-a-th
  consentimientoIp    String? // hash de IP — prueba del consentimiento (formulario web)
  consentimientoTexto String? // snapshot del texto aceptado — prueba del consentimiento

  resumenIA String? // Etapa 2: resumen ejecutivo generado (sugerencia, decisión humana)
  datosIA   Json? // Etapa 2: extracción estructurada del CV

  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postulaciones Postulacion[]

  @@index([createdAt])
  @@map("candidatos")
}

model Postulacion {
  id          String    @id @default(cuid())
  candidatoId String
  candidato   Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  vacanteId   String? // null = aplicación espontánea / banco
  vacante     Vacante?  @relation(fields: [vacanteId], references: [id], onDelete: SetNull)

  etapa         EtapaPostulacion @default(RECIBIDA)
  historial     Json? // [{ de, a, fecha, usuario }]
  notasInternas String?
  scoreIA       Int? // Etapa 2: match 0-100 (sugerencia IA, decisión humana)
  matchIA       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vacanteId, etapa])
  @@index([candidatoId])
  @@map("postulaciones")
}

// Checklist de dónde se publicó cada vacante. La fila del canal SPE
// (SENA / caja de compensación) documenta el cumplimiento del registro
// obligatorio (Ley 1636/2013 art. 31 — plazo 10 días hábiles).
model PublicacionVacante {
  id        String  @id @default(cuid())
  vacanteId String
  vacante   Vacante @relation(fields: [vacanteId], references: [id], onDelete: Cascade)

  canal            String // spe-sena | spe-comfandi | magneto | computrabajo | elempleo | linkedin | otro
  url              String?
  referencia       String? // número/código que asigne el prestador
  fechaPublicacion DateTime?
  fechaCierre      DateTime?
  notas            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vacanteId])
  @@map("publicaciones_vacante")
}

// Programa de Referidos ("Referidos que Construyen"): un código por empleado
// para que lo comparta con quien quiera referir. El código solo sirve para
// TRACKING de la fuente y el pago del incentivo (Art. 128 CST — bonificación
// ocasional por mera liberalidad, no constitutiva de salario) — NUNCA para
// saltarse la evaluación por mérito (Ley 931/2004): el candidato referido pasa
// por el mismo proceso de selección que cualquier otro.
model CodigoReferido {
  id             String   @id @default(cuid())
  nombreEmpleado String
  codigo         String   @unique
  activo         Boolean  @default(true)
  notas          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  candidatos Candidato[]

  @@map("codigos_referido")
}

model ConfiguracionTalento {
  id String @id @default("default")

  // El switch: cuando sea true, /trabaja-con-nosotros se vuelve pública
  // (ISR la levanta sin deploy). Mientras tanto todo es solo admin.
  paginaPublicaActiva Boolean @default(false)

  emailNotificaciones String? // a dónde avisar postulaciones nuevas (fase pública)
  retencionMeses      Int     @default(12) // purga de CVs sin consentimiento de banco
  textoConsentimiento String? // texto del checkbox habeas data (validar con jurídica)

  updatedAt DateTime @updatedAt

  @@map("configuracion_talento")
}
