generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String?
  name                String?
  role                UserRole             @default(VIEWER)
  avatar              String?
  emailVerified       DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  accounts            Account[]
  historias           HistoriaProyecto[]
  projects            Proyecto[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Proyecto {
  id                   String               @id @default(cuid())
  titulo               String
  codigoInterno        String?
  descripcion          String
  estado               EstadoProyecto       @default(PLANIFICACION)
  prioridad            PrioridadEnum        @default(MEDIA)
  fechaInicio          DateTime
  fechaFin             DateTime?
  fechaEstimada        DateTime?
  presupuesto          Decimal?             @db.Decimal(15, 2)
  costoReal            Decimal?             @db.Decimal(15, 2)
  moneda               String               @default("COP")
  cliente              String
  contactoCliente      String?
  telefono             String?
  email                String?
  ubicacion            String
  coordenadas          String?
  tags                 String[]
  destacado            Boolean              @default(false)
  destacadoEnCategoria Boolean              @default(false)
  visible              Boolean              @default(true)
  ordenFrontend        Int?
  slug                 String               @unique
  metaTitle            String?
  metaDescription      String?
  createdBy            String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  areaTotal            Decimal?             @db.Decimal(15, 2)
  toneladas            Decimal?             @db.Decimal(10, 2)
  clienteId            String?
  categoria            CategoriaEnum        @default(COMERCIAL)
  comentarios          ComentarioProyecto[]
  documentos           DocumentoProyecto[]
  historia             HistoriaProyecto?
  imagenes             ImagenProyecto[]
  progreso             ProgresoProyecto[]
  clienteRel           Cliente?             @relation(fields: [clienteId], references: [id])
  user                 User                 @relation(fields: [createdBy], references: [id])
  hojaVida             ProyectoHojaVida?
  timeline             TimelineEntry[]

  @@map("proyectos")
}

model ImagenProyecto {
  id           String     @id @default(cuid())
  url          String
  urlOptimized String?
  alt          String
  titulo       String?
  descripcion  String?
  orden        Int        @default(0)
  tipo         TipoImagen @default(GALERIA)
  size         Int?
  width        Int?
  height       Int?
  format       String?
  proyectoId   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  proyecto     Proyecto?  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@map("imagenes_proyecto")
}

model DocumentoProyecto {
  id          String        @id @default(cuid())
  nombre      String
  descripcion String?
  url         String
  tipo        TipoDocumento
  size        Int?
  formato     String?
  proyectoId  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  proyecto    Proyecto      @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@map("documentos_proyecto")
}

model ProgresoProyecto {
  id          String    @id @default(cuid())
  fase        String
  descripcion String?
  porcentaje  Int       @default(0)
  fechaInicio DateTime?
  fechaFin    DateTime?
  completado  Boolean   @default(false)
  orden       Int       @default(0)
  proyectoId  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  proyecto    Proyecto  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@map("progreso_proyecto")
}

model TimelineEntry {
  id          String       @id @default(cuid())
  titulo      String
  descripcion String?
  fecha       DateTime
  tipo        TipoTimeline @default(HITO)
  importante  Boolean      @default(false)
  proyectoId  String
  createdAt   DateTime     @default(now())
  proyecto    Proyecto     @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@map("timeline_proyecto")
}

model ComentarioProyecto {
  id         String   @id @default(cuid())
  contenido  String
  interno    Boolean  @default(true)
  proyectoId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@map("comentarios_proyecto")
}

model Servicio {
  id                   String   @id @default(cuid())
  nombre               String
  descripcion          String
  caracteristicas      String[] @default([])
  icono                String?
  imagen               String?
  orden                Int      @default(0)
  destacado            Boolean  @default(false)
  activo               Boolean  @default(true)
  slug                 String   @unique
  metaTitle            String?
  metaDescription      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  bgGradient           String?
  color                String   @default("blue")
  equipamiento         Json?
  equipos              Json?
  expertiseDescripcion String?
  expertiseTitulo      String?
  normativas           Json?
  subtitulo            String?
  tecnologias          Json?
  titulo               String?
  imagenesGaleria      Json?
  estadisticas         Json?
  procesoPasos         Json?
  tablaComparativa     Json?
  videoDemostrativo    String?
  preguntasFrecuentes  Json?
  recursosDescargables Json?

  @@map("servicios")
}

model Cliente {
  id                String        @id @default(cuid())
  nombre            String
  logo              String?
  logoBlanco        String?
  descripcion       String?
  sitioWeb          String?
  sector            SectorCliente
  proyectoDestacado String?
  capacidadProyecto String?
  ubicacionProyecto String?
  mostrarEnHome     Boolean       @default(true)
  destacado         Boolean       @default(false)
  orden             Int           @default(0)
  activo            Boolean       @default(true)
  slug              String        @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  proyectos         Proyecto[]

  @@map("clientes")
}

model ContactForm {
  id         String   @id @default(cuid())
  nombre     String
  email      String
  telefono   String?
  empresa    String?
  mensaje    String
  origen     String?
  leido      Boolean  @default(false)
  respondido Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("formularios_contacto")
}

model ConfiguracionSitio {
  id          String     @id @default(cuid())
  clave       String     @unique
  valor       String
  descripcion String?
  tipo        TipoConfig @default(TEXTO)
  categoria   String?
  updatedAt   DateTime   @updatedAt

  @@map("configuracion_sitio")
}

model CategoriaProyecto {
  id                  String        @id @default(cuid())
  nombre              String
  descripcion         String?
  slug                String        @unique
  imagenCover         String?
  icono               String?
  color               String?
  colorSecundario     String?
  metaTitle           String?
  metaDescription     String?
  orden               Int           @default(0)
  visible             Boolean       @default(true)
  destacada           Boolean       @default(false)
  totalProyectos      Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  overlayColor        String?
  overlayOpacity      Float?        @default(0.0)
  hoverOverlayColor   String?       @default("#1e40af")
  hoverOverlayOpacity Float?        @default(0.2)
  enableHoverOverlay  Boolean       @default(true)
  descripcionAmpliada String?
  estadisticas        Json?
  procesoTrabajo      Json?
  casosExitoIds       Json?
  imagenBanner        String?
  videoBanner         String?
  videoCover          String?
  usarVideoBanner     Boolean       @default(false)
  usarVideoCover      Boolean       @default(false)
  videoBannerPosition String?       @default("center center")
  videoBannerScale    Float?        @default(1.0)
  videoCoverPosition  String?       @default("center center")
  videoCoverScale     Float?        @default(1.0)
  key                 CategoriaEnum @unique
  especialidades      Json?
  brochure            Brochure?

  @@map("categorias_proyecto")
}

model HistoriaProyecto {
  id                  String   @id @default(cuid())
  proyectoId          String   @unique
  activo              Boolean  @default(false)
  contexto            String?
  desafios            Json?
  problemasIniciales  String?
  enfoque             String?
  solucionTecnica     String?
  innovaciones        Json?
  equipoEspecialista  Json?
  metodologia         String?
  fasesEjecucion      Json?
  tiempoTotal         String?
  recursos            Json?
  resultados          Json?
  impactoCliente      String?
  reconocimientos     Json?
  datosInteres        Json?
  leccionesAprendidas String?
  valorAgregado       String?
  testimonioCliente   String?
  testimonioEquipo    String?
  imagenDestacada     String?
  videoUrl            String?
  infografias         Json?
  tagsTecnicos        Json?
  dificultadTecnica   Int?
  innovacionNivel     Int?
  resumenCorto        String?
  tituloAlternativo   String?
  fechaCreacion       DateTime @default(now())
  fechaActualizacion  DateTime @updatedAt
  creadoPor           String
  imagenesDesafio     Json?
  imagenesResultado   Json?
  imagenesSolucion    Json?
  creador             User     @relation(fields: [creadoPor], references: [id])
  proyecto            Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@map("historias_proyecto")
}

model ProyectoHojaVida {
  id                    String        @id @default(cuid())
  entidadContratante    String
  objetoContrato        String
  tituloDisplay         String?
  descripcionSecundaria String?
  fechaInicio           DateTime
  fechaFin              DateTime
  pesoKg                Decimal?      @db.Decimal(12, 2)
  areaM2                Decimal?      @db.Decimal(12, 2)
  ubicacion             String
  departamento          String?
  valorContrato         Decimal       @db.Decimal(15, 2)
  moneda                String        @default("COP")
  imagenes              Json?
  destacado             Boolean       @default(false)
  visible               Boolean       @default(true)
  orden                 Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  proyectoDetalladoId   String?       @unique
  categoria             CategoriaEnum @default(INDUSTRIAL)
  proyectoDetallado     Proyecto?     @relation(fields: [proyectoDetalladoId], references: [id])

  @@map("proyectos_hoja_vida")
}

model ConfiguracionTrayectoria {
  id              String   @id @default(cuid())
  resenaHistorica String
  mision          String
  vision          String
  valores         Json
  updatedAt       DateTime @updatedAt

  @@map("configuracion_trayectoria")
}

model ResumenAnio {
  id               String   @id @default(cuid())
  anio             Int      @unique
  titulo           String
  descripcion      String
  categorias       Json?
  imagenesFeatured Json?
  estadisticas     Json?
  visible          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("resumenes_anio")
}

model BrochureTemplate {
  id                String                 @id @default(cuid())
  nombre            String
  descripcion       String?
  thumbnail         String?
  estructura        Json
  componentsLibrary Json
  estilosGlobales   Json?
  isPublic          Boolean                @default(false)
  isDefault         Boolean                @default(false)
  createdBy         String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  tipoCategoria     CategoriaEnum?
  pages             BrochureTemplatePage[]
  brochures         Brochure[]

  @@map("brochure_templates")
}

model BrochureTemplatePage {
  id         String           @id @default(cuid())
  templateId String
  nombre     String
  orden      Int              @default(0)
  estructura Json
  estilos    Json?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  template   BrochureTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("brochure_template_pages")
}

model Brochure {
  id                  String             @id @default(cuid())
  titulo              String
  descripcion         String?
  templateId          String
  categoriaId         String?            @unique
  contenido           Json
  datosPersonalizados Json?
  configuracion       Json?
  activo              Boolean            @default(false)
  publicado           Boolean            @default(false)
  fechaPublicacion    DateTime?
  urlAmigable         String             @unique
  versionNumero       Int                @default(1)
  thumbnail           String?
  pdfUrl              String?
  createdBy           String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  analytics           BrochureAnalytics?
  pages               BrochurePage[]
  categoria           CategoriaProyecto? @relation(fields: [categoriaId], references: [id])
  template            BrochureTemplate   @relation(fields: [templateId], references: [id])

  @@map("brochures")
}

model BrochurePage {
  id              String        @id @default(cuid())
  brochureId      String
  pageTemplateId  String?
  nombre          String
  orden           Int           @default(0)
  canvasData      Json?
  contenido       Json?
  componentesData Json?
  configuracion   Json?
  visible         Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  brochure        Brochure      @relation(fields: [brochureId], references: [id], onDelete: Cascade)
  pageTemplate    PageTemplate? @relation(fields: [pageTemplateId], references: [id])

  @@map("brochure_pages")
}

model PageTemplate {
  id            String         @id @default(cuid())
  nombre        String
  descripcion   String?
  thumbnail     String?
  categoria     String?
  canvasData    Json
  configuracion Json?
  isPublic      Boolean        @default(true)
  usageCount    Int            @default(0)
  createdBy     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  pages         BrochurePage[]

  @@map("page_templates")
}

model BrochureComponent {
  id                String                 @id @default(cuid())
  nombre            String
  tipo              TipoComponenteBrochure
  descripcion       String?
  thumbnail         String?
  htmlTemplate      String
  cssEstilos        String
  jsInteracciones   String?
  propiedadesSchema Json
  valorDefecto      Json?
  categoria         String?
  tags              String[]
  isPublic          Boolean                @default(true)
  usageCount        Int                    @default(0)
  createdBy         String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@map("brochure_components")
}

model BrochureStyle {
  id               String   @id @default(cuid())
  nombre           String
  descripcion      String?
  coloresPrimarios Json
  tipografia       Json
  espaciado        Json?
  bordes           Json?
  sombras          Json?
  efectos          Json?
  cssCustom        String?
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("brochure_styles")
}

model BrochureAnalytics {
  id          String   @id @default(cuid())
  brochureId  String   @unique
  vistas      Int      @default(0)
  descargas   Int      @default(0)
  compartidos Int      @default(0)
  fecha       DateTime @default(now())
  brochure    Brochure @relation(fields: [brochureId], references: [id], onDelete: Cascade)

  @@map("brochure_analytics")
}

model CustomFont {
  id          String   @id @default(cuid())
  nombre      String   @unique
  fontFamily  String
  fileUrl     String
  fileName    String
  fileFormat  String
  fileSize    Int?
  description String?
  category    String?
  isActive    Boolean  @default(true)
  uploadedBy  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("custom_fonts")
}

model ContactoWhatsApp {
  id                    String   @id @default(cuid())
  nombre                String
  cargo                 String
  telefono              String
  mensajePredeterminado String   @default("Hola, me gustaría solicitar información sobre sus servicios.")
  avatar                String?
  orden                 Int      @default(0)
  activo                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("contactos_whatsapp")
}

model ConfiguracionWhatsApp {
  id                  String   @id @default(cuid())
  horarioAtencion     String   @default("Lunes a Viernes: 7:00 AM - 5:00 PM")
  mensajeIntroduccion String   @default("Elije la persona disponible para iniciar una conversación de WhatsApp")
  tituloWidget        String   @default("Háblanos por WhatsApp")
  activo              Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  @@map("configuracion_whatsapp")
}

model SiteConfig {
  id               String   @id @default(cuid())
  key              String   @unique @default("global")
  categoryIconSize Int      @default(48)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@map("site_config")
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

enum SectorCliente {
  INDUSTRIAL
  COMERCIAL
  CONSTRUCCION
  INSTITUCIONAL
  GOBIERNO
  ENERGIA
  MINERIA
  SALUD
  OTRO
}

enum CategoriaEnum {
  COMERCIAL
  INDUSTRIAL
  PUENTES
  INFRAESTRUCTURA_URBANA
  EDIFICACIONES
  DEPORTES_EDUCACION
}

enum EstadoProyecto {
  PLANIFICACION
  EN_PROGRESO
  PAUSADO
  COMPLETADO
  CANCELADO
}

enum PrioridadEnum {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum TipoImagen {
  PORTADA
  GALERIA
  PROCESO
  ANTES_DESPUES
  PLANOS
}

enum TipoDocumento {
  CONTRATO
  PLANOS
  ESPECIFICACIONES
  REPORTES
  CERTIFICADOS
  FACTURACION
  OTRO
}

enum TipoTimeline {
  INICIO
  HITO
  ENTREGA
  PROBLEMA
  SOLUCION
  FINALIZACION
}

enum TipoConfig {
  TEXTO
  NUMERO
  BOOLEAN
  JSON
  URL
  EMAIL
}

enum TipoComponenteBrochure {
  COVER_PAGE
  PROJECT_CARD
  PROJECT_GRID
  STATS_BOX
  STATS_GRID
  IMAGE_GALLERY
  HERO_SECTION
  TEXT_BLOCK
  TITLE_SECTION
  CONTACT_INFO
  TIMELINE
  TECHNICAL_SPECS
  CLIENT_LOGO
  DIVIDER
  SPACER
  CUSTOM_HTML
}

// =====================================================================
// Admin v2 — Fase 1: Plantas
// Fuente única para las 3 plantas de MEISA (Jamundí, Popayán, Villa Rica).
// Reemplaza PLANTS en lib/company-data.ts y plantas hardcoded en
// app/(public)/contacto/page.tsx — usadas por /empresa y /contacto.
// =====================================================================
model Plant {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  nombre                String
  tipo                  String?
  ubicacion             String
  ciudad                String?
  departamento          String?
  areaM2                Int?
  naves                 Int?
  capacidadGruaTon      Int?
  mesasCnc              Int?
  equipamientoAdicional String[] @default([])
  telefono              String?
  email                 String?
  horario               String?
  googleMapsUrl         String?
  mapEmbedUrl           String?
  lat                   Float?
  lng                   Float?
  imagen                String?
  descripcion           String?
  colorGradient         String?
  orden                 Int      @default(0)
  activo                Boolean  @default(true)
  esSedePrincipal       Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("plantas")
}

// =====================================================================
// Admin v2 — Fase 2: Empresa
// Reemplaza COMPANY_INFO, LEADERSHIP_QUOTE, COMPANY_HISTORY, SAFETY_CONTENT,
// SUSTAINABILITY_CONTENT, CORPORATE_VALUES, CERTIFICATIONS,
// STANDARDS_COMPLIANCE en lib/company-data.ts — usados en /empresa.
// =====================================================================

// Singleton (usa id = "default")
model ConfiguracionEmpresa {
  id                        String   @id @default("default")
  // Identidad
  nombre                    String   @default("MEISA")
  nombreCompleto            String   @default("Metálicas e Ingeniería S.A.S.")
  mision                    String
  vision                    String
  descripcion               String
  fundacion                 Int      @default(1996)
  // Liderazgo (cita)
  liderQuoteTexto           String?
  liderQuoteAutor           String?
  liderQuoteCargo           String?
  liderQuoteImagen          String?
  // Historia
  historiaIntro             String[] @default([])
  // "Creemos en..."
  frasesCreemos             String[] @default([])
  // Compromiso — Seguridad
  seguridadTitulo           String?
  seguridadSubtitulo        String?
  seguridadItems            String[] @default([])
  seguridadMeta             String?
  // Compromiso — Sostenibilidad
  sostenibilidadTitulo      String?
  sostenibilidadSubtitulo   String?
  sostenibilidadItems       String[] @default([])
  sostenibilidadCompromiso  String?
  updatedAt                 DateTime @updatedAt

  @@map("configuracion_empresa")
}

model CompanyValue {
  id          String   @id @default(cuid())
  slug        String   @unique
  nombre      String
  descripcion String
  icono       String?
  imagen      String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("valores_corporativos")
}

model TimelineHito {
  id          String   @id @default(cuid())
  periodo     String   // "1996", "2006-2010"
  titulo      String
  descripcion String
  destacado   String?  // "Inicio de operaciones", "RUC Certificado"
  icono       String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("timeline_hitos")
}

model Certificacion {
  id              String   @id @default(cuid())
  slug            String   @unique
  nombre          String
  nombreCompleto  String?
  descripcion     String?
  emisor          String?
  importancia     String?
  beneficios      String[] @default([])
  logo            String?
  documentoUrl    String?
  vigenciaDesde   DateTime?
  vigenciaHasta   DateTime?
  orden           Int      @default(0)
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("certificaciones")
}

model Norma {
  id          String   @id @default(cuid())
  codigo      String   @unique // "NSR-10", "AWS D1.1"
  descripcion String
  categoria   String?
  logo        String?
