# Database
DATABASE_URL="postgresql://username:password@localhost:5432/meisa_db"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# File Upload
UPLOADCARE_PUBLIC_KEY="your-uploadcare-public-key"
UPLOADCARE_SECRET_KEY="your-uploadcare-secret-key"

# AI Image Upscaling (Replicate)
REPLICATE_API_TOKEN="r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Email / Password reset (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="no-reply@meisa.com.co"

# Google APIs (optional)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Configuración MEISA
MEISA_ADMIN_EMAIL="admin@meisa.com.co"
MEISA_COMPANY_NAME="MEISA - Metálicas e Ingeniería S.A."
MEISA_CONTACT_EMAIL="contacto@meisa.com.co"
MEISA_CONTACT_PHONE="+57 300 123 4567"

# Destinatarios para notificaciones del formulario /contacto.
# Lista de correos separados por coma. Si está vacío se usa MEISA_ADMIN_EMAIL.
# Ejemplo: "ventas@meisa.com.co,gerencia@meisa.com.co"
MEISA_CONTACT_NOTIFY_TO=""

# ====== Asistente comercial IA (chatbot) ======
# Encender/apagar el widget en el cliente y el endpoint en el servidor.
NEXT_PUBLIC_CHAT_ENABLED="false"
CHAT_ENABLED="true"

# --- Vertex AI (Gemini) ---
GCP_PROJECT_ID="tu-proyecto-gcp"

# Proyecto que contiene la colección maestra `colaboradores`. Usa las mismas
# credenciales GOOGLE_SERVICE_ACCOUNT_* salvo que se definan FIRESTORE_SA_*.
FIRESTORE_COLABORADORES_PROJECT_ID="produccion-reportes"
# Opción recomendada en hosting: JSON completo de una cuenta con
# roles/datastore.viewer en produccion-reportes.
FIRESTORE_SA_KEY_JSON=""
# Alternativa equivalente con las credenciales separadas:
FIRESTORE_SA_EMAIL=""
FIRESTORE_SA_PRIVATE_KEY=""
VERTEX_LOCATION="global"
# Confirmar el ID exacto del modelo en Vertex AI. 3.1 Flash-Lite es preview;
# alternativa GA estable: "gemini-2.5-flash-lite".
VERTEX_MODEL="gemini-3.1-flash-lite-preview"
# Service account con rol roles/aiplatform.user. Si se dejan vacías, se reusan
# las de Gmail DWD (GOOGLE_SERVICE_ACCOUNT_EMAIL / _PRIVATE_KEY).
VERTEX_SA_EMAIL=""
VERTEX_SA_PRIVATE_KEY=""

# --- Precios por 1M tokens (USD) para estimar costo. Default = Gemini 3.1 Flash-Lite ---
CHAT_PRICE_INPUT="0.25"
CHAT_PRICE_OUTPUT="1.5"

# --- Circuit breaker: techo DURO de gasto (corte automático) ---
CHAT_DAILY_CAP_USD="1.5"
CHAT_MONTHLY_CAP_USD="10"

# --- Límites por conversación ---
CHAT_MAX_TURNOS="15"
CHAT_MAX_CHARS="1000"
CHAT_MAX_OUTPUT_TOKENS="600"
CHAT_HISTORIAL_MAX="16"

# --- Rate limit por IP ---
CHAT_RATE_MIN="5"
CHAT_RATE_DIA="40"

# --- Cloudflare Turnstile (anti-bot). Vacío = no se exige (dev) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""

# Sal para hashear IPs (privacidad). Cualquier string secreto.
CHAT_IP_SALT="cambia-esto"

# ====== Integración: portal de colaboradores (código de referido) ======
# Llave compartida que debe enviar el BACKEND del portal de colaboradores
# como "Authorization: Bearer <valor>" al llamar
# GET /api/integraciones/colaboradores/codigo-referido?cedula=... .
# Nunca debe llegar al navegador del empleado. Ver docs/integracion-portal-colaboradores.md.
PORTAL_COLABORADORES_API_KEY=""
